# Turso Database
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Optional: LLM replies. Without this key the diary uses its offline
# branching-response engine (~250 curated replies) and still works.
NVIDIA_API_KEY=nvapi-your-key-here

# Optional: requests allowed per minute per IP+username on /api/interact.
# Defaults to 20. Guards the one endpoint that spends money.
RATE_LIMIT_PER_MINUTE=20

# Optional: the per-IP ceiling on /api/interact (a client can invent new
# usernames freely, so the IP is the real abuse bound). Defaults to 3x the
# per-name limit, so households or offices sharing one address still work.
RATE_LIMIT_IP_PER_MINUTE=60
